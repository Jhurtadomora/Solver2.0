name: Mantener la app despierta

on:
  schedule:
    - cron: "0 */6 * * *"   # cada 6 horas
  workflow_dispatch:          # permite ejecutarlo a mano desde la pestaña Actions

jobs:
  despertar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Instalar navegador
        run: pip install playwright && python -m playwright install --with-deps chromium
      - name: Visitar la app
        env:
          APP_URL: https://solver20-xumh5q2pq5t2jungvtcoh3.streamlit.app
        run: |
          python - <<'PY'
          import os
          from playwright.sync_api import sync_playwright
          with sync_playwright() as p:
              navegador = p.chromium.launch()
              pagina = navegador.new_page()
              pagina.goto(os.environ["APP_URL"], wait_until="domcontentloaded", timeout=120000)
              pagina.wait_for_timeout(8000)
              boton = pagina.get_by_role("button", name="Yes, get this app back up!")
              if boton.count():
                  print("La app estaba dormida: despertándola...")
                  boton.first.click()
                  pagina.wait_for_timeout(90000)
              else:
                  print("La app ya estaba despierta.")
              navegador.close()
          PY
